{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bage-rate",
  "version": "0.1.3",
  "identifier": "dev.karthik.bage-rate",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bage-rate",
        "url": "index.html?view=overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "width": 800,
        "height": 600,
        "focusable": false
      },
      {
        "label": "settings",
        "title": "bage-rate Settings",
        "url": "index.html?view=settings",
        "visible": false,
        "resizable": false,
        "dragDropEnabled": false,
        "width": 460,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; frame-src 'self' animation: http://animation.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
